#!/usr/bin/env bash
# Gates, commits and pushes this repo in one command.
#
# **Because four round trips is three too many.** Committing, clearing the
# copy gate, pushing and deploying were four separate things to ask for, and
# on a day with four changes in it that is sixteen asks. This is the one
# command, and the order it runs things in is the whole of what it knows.
#
# **The cheap checks run first, and that is the point.** The gate is three
# minutes. A copy marker and an unsigned page are a grep and a hash, so they
# go in front: being told after three minutes that a word was never Jake's is
# three minutes for nothing, and it is the commonest way this stops.
#
# **It does not sign anything.** The gate's whole claim is that Jake read the
# words. A signature that happened as a side effect of shipping would be a
# blanket say-so with nothing on screen, which is the case ~/.claude/voice/
# sign-copy was written to stop. So an unsigned string ends the run and says
# where it is. Signing stays his, and this is the door it opens.
#
# **Pushing is ../push and not a git push here.** This project is six repos
# that depend on each other and a change often lands in two, so the order
# they go in is a real question and ../push is already the one account of it.
# A `git push` in here would be a second, and the pair would go out of step
# the first time the engine changed with the game.
#
# **And one check that is not about the code at all.** `../check-specs` reads
# every criterion's citation, and only `../check-all` used to run it, so a
# commit from here could kill a test a spec names and go out green. It is
# asked of this repo alone, which is the difference between under a minute
# and five.
#
# There is nothing to deploy from this repo. The game is a binary somebody
# builds, and blitzkit's site is the engine's to publish.
#
# Usage: ./scripts/ship "<message>" [<path> ...]
#   (no paths)   every tracked change in this repo
#   <path>...    only those, as `git commit -- <path>`
set -uo pipefail

if [ "${1:-}" = "--help" ] || [ "${1:-}" = "-h" ] || [ "$#" -eq 0 ]; then
  # **The header to its end, and not a line range.** This read `2,32p`,
  # which is a number that has to be moved every time the header grows and
  # was not: adding the specs step pushed the usage block past it. The
  # header is every comment line from the second to the first line that is
  # not one, which is a thing the file can answer for itself.
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); print; next } NR > 1 { exit }' "$0"
  [ "$#" -eq 0 ] && exit 1
  exit 0
fi

message="$1"
shift

here=$(cd "$(dirname "$0")/.." && pwd)
project=$(cd "$here/.." && pwd)
cd "$here" || exit 1

stop() {
  echo
  echo "nothing was committed: $1"
  exit 1
}

# **How many rustc at once**, which is ./check-all's number and its reason.
# Cargo's default is one per core, eighteen on this machine, and eighteen
# linking at once is what has filled its memory more than once during an
# unattended gate. This was written without the cap and the second run of it
# took the one minute load average to 27 with 64 MB free.
#
# Overridable, because the number is this machine's and the script is not.
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-4}

# **Is there anything to do at all.** A run with a clean tree and nothing
# ahead would spend three minutes proving it, which is how a command stops
# being reached for.
# **Asked whether there is an upstream at all, rather than reading a silent
# failure as good news.** `git log @{u}..HEAD` on a branch with no upstream
# says nothing and exits non-zero, so a bare test of its output reads a repo
# that has never been pushed as a repo with nothing to push.
ahead=unknown
if git rev-parse --abbrev-ref '@{u}' > /dev/null 2>&1; then
  ahead=$(git log --oneline '@{u}..HEAD')
fi

if [ -z "$(git status --porcelain)" ] && [ -z "$ahead" ]; then
  echo "nothing to ship: the tree is clean and origin has everything"
  exit 0
fi

# **What the commit will be, asked before the gate and not after it.** Both
# of these are a git call and certain, and the gate is four minutes. They sat
# under the commit step at first, which meant a run that could never commit
# spent four minutes proving its tests still passed before saying so. Cheap
# and certain in front of slow is the whole of this script's order.
#
# Only when there are no paths and something to commit: with paths named,
# `git commit -- <path>` refuses an untracked one itself and says so.
if [ "$#" -eq 0 ] && [ -n "$(git status --porcelain)" ]; then
  # **A half-staged index is not swept in.** Jake stages work as a
  # checkpoint, and a commit of everything tracked takes the lot.
  if [ -n "$(git diff --cached --name-only)" ]; then
    echo "something is already staged:"
    git diff --cached --name-only | sed 's/^/  /'
    stop "name the paths you mean, or commit the staged work yourself"
  fi

  # **And a new file is not committed around.** `git commit -a` takes
  # tracked files only. The first real run of this shipped a commit that
  # declared `mod keys;`, named `src/keys.rs` in .copy-files and recorded a
  # signature for it, with the module itself left behind untracked: a commit
  # that cannot compile from a clean checkout, passing a gate that had just
  # run against a working tree where the file was there.
  #
  # Refused rather than swept in with `git add -A`, which would take build
  # output, editor leavings and whatever else is lying about.
  untracked=$(git ls-files --others --exclude-standard)

  if [ -n "$untracked" ]; then
    echo 'these are new, and a commit of everything tracked will not take them:'
    echo "$untracked" | sed 's/^/  /'
    stop "name them as paths, or git add them first"
  fi
fi

echo "== copy markers"
if ! "$project/check-copy" "$here"; then
  stop "a string here is still a draft"
fi

# The same check this repo's pre-push hook runs, asked now rather than after
# the gate. The hook stays: it is what holds for a push nobody shipped.
echo "== copy Jake has signed"
if [ -x "$HOME/.claude/voice/check-voice" ]; then
  if ! "$HOME/.claude/voice/check-voice"; then
    stop "a page here is not signed off"
  fi
else
  echo "   no ~/.claude/voice/check-voice here, so nothing was checked"
fi

# **This repo's gate and not ./check-all.** That one builds sixteen crates
# four ways and is for a release. What a commit here can break is here.
echo "== fmt"
cargo fmt
if [ -n "$(git status --porcelain)" ]; then
  echo "   fmt touched the tree; what it wrote goes in with the rest"
fi

echo "== clippy"
if ! cargo clippy --all-targets -- -D warnings; then
  stop "clippy is unhappy"
fi

# **The one check here that is not about this repo's code.** A spec cites the
# test that holds each of its criteria, and nothing in a cargo run reads a
# spec, so a test renamed or deleted leaves the spec citing a name that
# answers to nothing. That reads like the behaviour is covered, which is
# worse than no citation.
#
# **It was not here, and that cost a commit.** `a3db293` deleted two tests
# spec 0054 cited and went out green, because this script runs the repo's own
# gate and `../check-all` is the only thing that ran `../check-specs`. Three
# dead citations across two specs were found by hand afterwards.
#
# Asked of this repo alone. Checking a citation means listing the tests, and
# listing them means building them: the whole project is five minutes and
# this repo is under one, which is the difference between a check that runs
# on every ship and one that does not.
echo "== specs"
# **The path from the project root and not `basename`.** `check-specs`
# names its repos the way `../list-repos` prints them, and a game is
# `games/lantern` there: a basename would hand it "lantern", which is not a
# directory at the root, and anything copying this script would find that
# out rather than reading it here.
if ! "$project/check-specs" "${here#"$project"/}"; then
  stop "a spec cites something that is not there"
fi

echo "== tests"
if ! cargo test; then
  stop "a test failed"
fi

# **A clean tree is a run that only pushes.** Committing is one of the things
# this does and not the reason it exists: a gate that has gone green over
# commits already made is worth as much as one over a change just written,
# and `git commit` on nothing would end the run one step short of the push.
echo "== commit"
if [ -z "$(git status --porcelain)" ]; then
  echo "   nothing new to commit; what is already here is what goes"
elif [ "$#" -gt 0 ]; then
  # **The pathspec form, which commits the working tree for those paths and
  # not the index.** That is what is wanted nearly always and wrong exactly
  # when the two are meant to disagree: `git rm --cached` leaves the file on
  # disk, so this finds it there and puts it straight back, reporting success
  # and changing nothing. Commit that one by hand.
  # **Added first, because a path you named may be new.** `git commit --
  # <path>` refuses an untracked one outright, which made this the one thing
  # ship could not do: the no-paths branch refuses a new file on purpose, and
  # naming it got the same refusal from git for a different reason. Naming a
  # path is saying you mean it, so it is taken whether git has seen it before
  # or not. Found on 2026-11-17 trying to ship a new spec with this.
  git add -- "$@" || stop "git would not take those paths"
  git commit -m "$message" -- "$@" || stop "git would not commit those paths"
else
  git commit -a -m "$message" || stop "git would not commit"
fi

echo "== push"
# ../push takes every repo with work, engine first, and refuses on a dirty
# tree anywhere. If it refuses, the commit above still stands and is the
# thing to push once the rest is tidy.
if ! "$project/push"; then
  echo
  echo "committed here, but nothing was pushed. ../push says why above."
  exit 1
fi
